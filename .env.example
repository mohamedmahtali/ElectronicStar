# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=electronic_star
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme

DATABASE_URL=postgresql+asyncpg://app:changeme@postgres:5432/electronic_star

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
OPS_ADMIN_TOKEN=change-me-local-admin-token
OFFER_STALE_AFTER_HOURS=24

# Crawler scheduler
CRAWLER_MATERIEL_INTERVAL_MINUTES=60
CRAWLER_MATERIEL_ITEMCOUNT=20
CRAWLER_MATERIEL_REQUEST_QUEUE=crawler:run_requests:materiel
CRAWLER_LDLC_INTERVAL_MINUTES=60
CRAWLER_LDLC_ITEMCOUNT=20
CRAWLER_LDLC_REQUEST_QUEUE=crawler:run_requests:ldlc
CRAWLER_BOULANGER_INTERVAL_MINUTES=60
CRAWLER_BOULANGER_ITEMCOUNT=20
CRAWLER_BOULANGER_REQUEST_QUEUE=crawler:run_requests:boulanger
CRAWLER_CYBERTEK_INTERVAL_MINUTES=60
CRAWLER_CYBERTEK_ITEMCOUNT=20
CRAWLER_CYBERTEK_REQUEST_QUEUE=crawler:run_requests:cybertek
CRAWLER_GROSBILL_INTERVAL_MINUTES=60
CRAWLER_GROSBILL_ITEMCOUNT=20
CRAWLER_GROSBILL_REQUEST_QUEUE=crawler:run_requests:grosbill
CRAWLER_TOPACHAT_INTERVAL_MINUTES=60
CRAWLER_TOPACHAT_ITEMCOUNT=20
CRAWLER_TOPACHAT_REQUEST_QUEUE=crawler:run_requests:topachat
CRAWLER_LOG_LEVEL=INFO
CRAWLER_REQUEST_QUEUE=crawler:run_requests
CRAWLER_REQUEST_POLL_SECONDS=5
RAW_DOCUMENTS_DIR=/app/apps/crawler/raw_documents

# Prometheus / Grafana
PROMETHEUS_PUSHGATEWAY_URL=http://pushgateway:9091
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
